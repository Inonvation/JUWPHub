<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 只写必需项。App 图标在 Assets.xcassets/AppIcon.appiconset（2026-11-25 补），启动屏仍不给。 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>JUWPHub</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 不声明 UILaunchScreen 的话 iOS 会给应用加黑边，界面按小尺寸渲染。
	     空的 <dict/> = 系统兜底纯色（浅色下是一块与 App 无关的白），启动到首帧之间会闪一下。
	     2026-11-25 改成指命名颜色：`UIColorName` 取 Assets.xcassets 里的 LaunchBackground，
	     它的两档色值就是主题的 `background`（晴空蓝浅色 #F9F9FF / 深色 #0F1419，
	     见 shared/.../ui/theme/Palettes.kt），深浅色都跟着系统走。
	     **这条只能在 Info.plist 里写**：`UILaunchScreen` 是嵌套字典，XcodeGen 的
	     `INFOPLIST_KEY_*` 构建设置表达不了；颜色资源本身则由 Assets.xcassets 承担
	     （工程把整个 JUWPHub 目录当 sources，新 colorset 会被 actool 自动收进来）。 -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Compose Multiplatform 的 PlistSanityCheck 在启动时强制校验这一项，缺了直接抛异常
	     终止进程（侧载包一启动就闪退，栈顶是 PlistSanityCheck）。顺带解锁 ProMotion 120Hz。 -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- 允许侧载后通过 http 访问校园内网（教务部分端口是 HTTP）；正式上架时应改成最小域 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- 课表导出（CSV/JSON）落在 App 沙箱的 Documents/exports/，让它出现在「文件」App 里：
	     没有这两项，用户存完之后在自己的手机上根本找不到那个文件（写成功了却等于没存）。
	     代价是 Documents/ 会进 iCloud 备份，见 shared/.../platform/AppDirs.ios.kt 的说明。 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- 快趣出行「附近的单车」要用户位置（iOS 的 CLLocationManager）。
	     缺这一项时 requestWhenInUseAuthorization() **静默无效**：不弹框、状态一直
	     NotDetermined，地图上没有蓝点也没有「距你多远」，而代码不会报错——排查起来
	     像是「定位功能没写」。文案要说明用途，否则 App Store 审核会拒（侧载不影响，
	     但改起来是同一处）。 -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于在地图上显示你附近的共享单车与实时距离，以及计算骑行时的位置。</string>
	<!-- 相册两个用途说明（2026-11-26 补）。缺 `NSPhotoLibraryAddUsageDescription` 时
	     UIImageWriteToSavedPhotosAlbum（shared/.../ui/common/BitmapSave.ios.kt）不是返回错误，
	     而是**进程被系统直接终止**——存课表图 / 成绩单图一点就闪退，栈顶看不到我们的代码。
	     读的那条（选图）目前没有调用方，但先写明：以后接选图时同样缺不了。 -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于把课表、成绩单等图片保存到你的相册。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选择图片，例如给图片加水印或拼接。</string>
	<!-- 拉起微信（快趣出行「打开微信扫一扫」/「去微信结清」）。iOS 只开放 `weixin://`
	     一个公有 scheme，落点是微信首页（扫一扫要用户自己点）；`weixinULAPI` 是微信
	     OpenSDK 回跳用的，先声明着，将来接 SDK 就不用再改 plist。
	     这两项只在 `canOpenURL` 时被系统检查——**打开**自定义 scheme 不查白名单，
	     所以就算漏了也不会崩，只是 `canOpenURL` 永远返回 false、打开可能静默失败。 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>weixin</string>
		<string>weixinULAPI</string>
	</array>
</dict>
</plist>
