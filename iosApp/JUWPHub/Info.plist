<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 只写必需项。App 图标在 Assets.xcassets/AppIcon.appiconset（2026-11-25 补），启动屏仍不给。 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>JUWPHub</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 不声明 UILaunchScreen 的话 iOS 会给应用加黑边，界面按小尺寸渲染 -->
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Compose Multiplatform 的 PlistSanityCheck 在启动时强制校验这一项，缺了直接抛异常
	     终止进程（侧载包一启动就闪退，栈顶是 PlistSanityCheck）。顺带解锁 ProMotion 120Hz。 -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- 允许侧载后通过 http 访问校园内网（教务部分端口是 HTTP）；正式上架时应改成最小域 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- 课表导出（CSV/JSON）落在 App 沙箱的 Documents/exports/，让它出现在「文件」App 里：
	     没有这两项，用户存完之后在自己的手机上根本找不到那个文件（写成功了却等于没存）。
	     代价是 Documents/ 会进 iCloud 备份，见 shared/.../platform/AppDirs.ios.kt 的说明。 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
